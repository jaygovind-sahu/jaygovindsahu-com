---
import Base from "../layouts/Base.astro";
import resume from "../data/resume.json";

const { meta, experience } = resume;
const currentRole = experience.find((exp) => exp.current);
const [firstName, ...rest] = meta.name.split(" ");
const lastName = rest.join(" ");
const year = new Date().getFullYear();

// `em` renders the trailing word in italics, e.g. Pillow *Fables*.
const links = [
  { name: "Gallery", href: "https://gallery.jaygovindsahu.com", domain: "gallery.jaygovindsahu.com" },
  { name: "Resumetrics", href: "https://resumetrics.io", domain: "resumetrics.io" },
  { name: "Pillow ", em: "Fables", href: "https://pillowfables.com", domain: "pillowfables.com" },
  { name: "Dataguide", href: "https://dataguide.dev", domain: "dataguide.dev" },
];

const socials = [
  { name: "LinkedIn", href: meta.linkedin },
  { name: "Instagram", href: "https://instagram.com/sahuspix" },
];

const role = currentRole ? `${meta.headline} · ${currentRole.company}` : meta.headline;
---

<Base
  title={`${meta.name} — ${meta.headline}`}
  description={`${role}. Résumé, side projects, gallery and links.`}
>
  <div class="landing min-h-screen flex flex-col gap-14 lg:gap-24 px-[22px] py-7 md:px-12 md:py-12 lg:px-16">

    <!-- ── TOP BAR ─────────────────────────────────────────── -->
    <header class="w-full max-w-[1200px] mx-auto flex items-center justify-between gap-6 font-mono text-[11px] md:text-xs tracking-[0.06em] text-[color:var(--muted)]">
      <span>{meta.website}</span>
      <nav aria-label="Social" class="flex md:gap-5">
        {socials.map((social) => (
          <a href={social.href} class="soc inline-flex items-center min-h-[44px] px-2 last:pr-0">
            {social.name} ↗
          </a>
        ))}
      </nav>
    </header>

    <main id="main-content" class="w-full max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-14 lg:gap-16 xl:gap-24 lg:items-end">

      <!-- ── INTRO ───────────────────────────────────────────── -->
      <section class="flex flex-col gap-5 md:gap-7">
        <p class="m-0 font-mono text-[11px] md:text-xs tracking-[0.16em] uppercase text-[color:var(--accent)]">
          {role}
        </p>
        <h1 class="name m-0 font-display font-light text-[color:var(--ink)]">
          {firstName}<br /><em class="italic text-[color:var(--accent)]">{lastName}</em>
        </h1>
        <p class="m-0 max-w-[400px] font-body text-base md:text-[17px] leading-[1.65] text-[color:var(--muted)]">
          Sixteen years building data platforms across streaming, retail and finance — plus a few things of my own on the side.
        </p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2.5 sm:gap-3 pt-1.5 sm:pt-2">
          <a
            href="/resume/"
            class="btn inline-flex items-center justify-between sm:justify-start gap-2.5 min-h-[52px] sm:min-h-[48px] px-[22px] sm:px-6 rounded-full font-body text-[15px] font-medium bg-[color:var(--ink)] text-[color:var(--paper)] hover:bg-[color:var(--accent)] transition-colors"
          >
            Read the résumé
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <button
            type="button"
            id="pdf-download"
            class="btn no-print inline-flex items-center justify-between sm:justify-start gap-2.5 min-h-[52px] sm:min-h-[48px] px-[22px] sm:px-6 rounded-full font-body text-[15px] font-medium border border-[color:var(--ink)] text-[color:var(--ink)] hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] disabled:opacity-60 disabled:cursor-wait transition-colors"
          >
            <span data-label>Download PDF</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v13M6 11l6 6 6-6M5 20h14" /></svg>
          </button>
        </div>
      </section>

      <!-- ── INDEX ───────────────────────────────────────────── -->
      <section aria-labelledby="index-label" class="flex flex-col gap-3 md:gap-3.5">
        <h2 id="index-label" class="m-0 font-mono text-[11px] font-normal tracking-[0.16em] uppercase text-[color:var(--muted)]">
          Index
        </h2>
        <ul class="list-none m-0 p-0 border-b border-[color:var(--rule)]">
          {links.map((link, i) => (
            <li class="row-item border-t border-[color:var(--rule)]" style={`--i: ${i}`}>
              <a
                href={link.href}
                class="row grid grid-cols-[32px_minmax(0,1fr)_22px] md:grid-cols-[52px_minmax(0,1fr)_auto_28px] items-center gap-2.5 md:gap-4 py-[18px] md:py-[22px] text-[color:var(--ink)]"
              >
                <span aria-hidden="true" class="font-mono text-[11px] md:text-xs text-[color:var(--muted)]">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="flex flex-col gap-1 md:contents">
                  <span class="row-title font-display text-[36px] md:text-[46px] leading-none">
                    {link.name}{link.em && <em>{link.em}</em>}
                  </span>
                  <span class="font-mono text-[11px] md:text-xs text-[color:var(--muted)]">{link.domain}</span>
                </span>
                <span class="row-arrow flex" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9" /></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <!-- ── FOOTER ──────────────────────────────────────────── -->
    <footer class="w-full max-w-[1200px] mx-auto mt-auto flex justify-between flex-wrap gap-4 pt-[22px] border-t border-[color:var(--rule)] font-mono text-[11px] tracking-[0.06em] text-[color:var(--muted)]">
      <span>© {year} {meta.name}</span>
      <span>Based in Pennsylvania</span>
    </footer>
  </div>
</Base>

<script>
  // The PDF renderer bundle is ~2.5 MB, so it is only fetched once the
  // visitor shows intent (hover/focus) or clicks — never on page load.
  const button = document.getElementById("pdf-download") as HTMLButtonElement | null;
  const label = button?.querySelector<HTMLElement>("[data-label]");

  const loadPdfModules = () =>
    Promise.all([import("../components/DownloadButton.jsx"), import("../data/resume.json")]);

  let modules: ReturnType<typeof loadPdfModules> | undefined;
  const preload = () => (modules ??= loadPdfModules());
  const warmUp = () => preload().catch(() => (modules = undefined));

  button?.addEventListener("pointerenter", warmUp, { once: true });
  button?.addEventListener("focus", warmUp, { once: true });
  button?.addEventListener("click", async () => {
    if (!button || !label) return;
    button.disabled = true;
    label.textContent = "Preparing…";
    try {
      const [{ downloadResumePdf }, { default: resume }] = await preload();
      await downloadResumePdf(resume);
    } catch (error) {
      modules = undefined; // allow a retry after a failed chunk load
      console.error(error);
    } finally {
      button.disabled = false;
      label.textContent = "Download PDF";
    }
  });
</script>

<style>
  .name {
    font-size: clamp(64px, 20vw, 100px);
    line-height: 0.86;
    letter-spacing: -0.025em;
  }
  @media (min-width: 1024px) {
    .name {
      font-size: clamp(64px, 8.5vw, 116px);
    }
  }

  .landing a:focus-visible,
  .landing button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .soc {
    transition: color 0.2s;
  }
  .soc:hover {
    color: var(--accent);
  }

  /* Index rows: title slides, arrow nudges toward the link */
  .row-title,
  .row-arrow {
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), color 0.25s;
  }
  @media (hover: hover) {
    .row:hover .row-title {
      transform: translateX(14px);
      color: var(--accent);
    }
    .row:hover .row-arrow {
      transform: translate(4px, -4px);
      color: var(--accent);
    }
  }
  .row:focus-visible .row-title {
    color: var(--accent);
  }

  /* Staggered entrance for the index (the h1 stays static for LCP) */
  .row-item {
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(0.1s + var(--i) * 0.07s);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row-item {
      animation: none;
    }
    .row-title,
    .row-arrow {
      transition: none;
    }
  }

  @media print {
    .row-item {
      animation: none;
    }
  }
</style>
